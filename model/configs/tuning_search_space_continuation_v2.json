{
  "schema_version": 1,
  "selection_data": "locked validation only",
  "objective": "maximize validation macro F1",
  "studies": 3,
  "trials_per_study": 4,
  "epochs_per_trial": 6,
  "sampler": "Optuna TPESampler(seed=42, n_startup_trials=3)",
  "pre_registered_control_trial": true,
  "fixed": {
    "input_size": "inherit parent",
    "batch_size": "inherit architecture-safe parent value",
    "preprocessing": "inherit validation-selected parent",
    "weights": "inherit official/ImageNet parent weights",
    "seed": 42,
    "test_access": "prohibited"
  },
  "search": {
    "optimizer": ["adamw", "sgd"],
    "learning_rate_adamw": [0.00003, 0.0003, "log"],
    "learning_rate_sgd": [0.0001, 0.003, "log"],
    "weight_decay": [0.000001, 0.001, "log"],
    "scheduler": ["reduce_on_plateau", "cosine"],
    "loss": ["cross_entropy", "focal_gamma_2"],
    "class_weighting": ["balanced", "none"],
    "label_smoothing": [0.0, 0.05],
    "augmentation": ["none", "conservative_flip_0.5_rotation_5deg"]
  },
  "not_tuned": {
    "dropout": "not exposed consistently across all supported heads",
    "freeze_backbone": "excluded to avoid mixing head-only and full-network optimization in the small trial budget",
    "batch_size": "kept fixed per architecture so learning-rate effects are not confounded by a second resource-dependent variable",
    "input_size": "kept at 224 to preserve the completed-control contract"
  }
}
